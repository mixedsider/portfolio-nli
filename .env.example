# NLI Gateway bind address.
# Use 0.0.0.0 on a server so a reverse proxy can reach the Gateway.
NLI_HOST=0.0.0.0

# NLI Gateway port used by the portfolio frontend.
NLI_PORT=8787

# Qwen escalation endpoint (legacy LM_STUDIO_* names are preserved).
LM_STUDIO_BASE_URL=http://192.168.0.57:1234/v1

# Exact requested Qwen ID; configured identity is not readiness proof.
LM_STUDIO_MODEL=Qwen3.8-27B-UD-Q4_K_M

# The gateway sends both `reasoning_effort: "none"` and
# `chat_template_kwargs: { enable_thinking: false }` to Chat Completions.
# These request options alone do not prove reasoning is disabled.
# These are intentionally not environment settings; re-probe when changing models or LM Studio versions.

# Maximum wait time for LM Studio responses in milliseconds.
LM_STUDIO_TIMEOUT_MS=16000

# Maximum generated tokens and upstream response bytes accepted from LM Studio.
LM_STUDIO_MAX_TOKENS=768
LM_STUDIO_MAX_RESPONSE_BYTES=65536

# Maximum concurrent Qwen calls handled by this Gateway process.
LM_STUDIO_MAX_CONCURRENT_REQUESTS=4

# Output modes accept only json_schema or plain. No automatic retry in another mode.
# Final retained defaults are json_schema; neither endpoint passed live activation.
# Do not switch to plain or raise caps to hide a failing verification.
LM_STUDIO_OUTPUT_MODE=json_schema

# Independent LFM primary endpoint and exact requested model ID.
LFM_BASE_URL=http://192.168.0.106:1234/v1
# Current GTX1060-optimized loaded Q4_0 model; do not use the unloaded @q4_0 alias.
LFM_MODEL=lfm2.5-2.6b
LFM_TIMEOUT_MS=6000
LFM_MAX_TOKENS=512
LFM_MAX_RESPONSE_BYTES=65536
LFM_MAX_CONCURRENT_REQUESTS=4
LFM_OUTPUT_MODE=json_schema

# Total application deadline and shared active upstream-operation limit.
NLI_CASCADE_TIMEOUT_MS=23000
NLI_CASCADE_MAX_CONCURRENT_REQUESTS=4

# Only true or false; enabled does not mean verified. Missing/stale receipts block Qwen.
NLI_QWEN_ENABLED=true
# Relative to the workspace containing tools/nli/config.mjs, never the launch cwd.
# Fresh evaluation qualification: tools/nli/eval-bound-probe.mjs --endpoint qwen --mode verify --receipt.
# This adapter invokes the existing atomic probe issuer; never annotate historical reports.
# Maximum age 24h; reverify after restart or model/build/template/prompt/schema/settings changes.
# Keep .env and .nli/ private and untracked. false is degraded mode, not full rollback.
NLI_QWEN_VERIFICATION_FILE=.nli/qwen-no-thinking.json

# Maximum JSON request body size for /api/nli in bytes.
NLI_MAX_REQUEST_BYTES=16384

# Maximum user message length for /api/nli.
NLI_MAX_MESSAGE_LENGTH=500

# Basic per-IP rate limit window and max request count.
NLI_RATE_LIMIT_WINDOW_MS=60000
NLI_RATE_LIMIT_MAX=30
NLI_RATE_LIMIT_MAX_BUCKETS=10000

# Inbound HTTP body/header receipt timeout, NOT the application response deadline.
# Application: 23000ms (6s LFM + 16s Qwen including metadata + 1s reserve).
# Evaluation HTTP callers default to 30000ms for response margin.
NLI_REQUEST_TIMEOUT_MS=15000

# Set to true only when a trusted reverse proxy owns X-Forwarded-For.
NLI_TRUST_PROXY=false

# Comma-separated browser origins. The Gateway denies browser origins when this is empty.
NLI_ALLOWED_ORIGINS=http://127.0.0.1:4173
